########################################
# CyberStream environment configuration
# Copy to .env and adjust. Never commit .env.
# Every variable here is read by name from backend/app/core/config.py,
# generator/config.py, and streaming/src/config.py - keep them in sync.
########################################

# --- Mode ---
# "dev"      = low resource footprint (few partitions, low rate)
# "loadtest" = higher partitions / throughput ceiling
CYBERSTREAM_MODE=dev

# --- Docker network (must match docker-compose.yml `networks:`) ---
COMPOSE_NETWORK_NAME=cyberstream-net

# --- Kafka ---
# _INTERNAL is the address containers use on the compose network.
# The non-_INTERNAL value is what you use from the host (Windows/mac/Linux).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:29092
KAFKA_NUM_PARTITIONS_DEV=3
KAFKA_NUM_PARTITIONS_LOADTEST=12
KAFKA_REPLICATION_FACTOR=1
KAFKA_CONSUMER_GROUP=cyberstream-processing
KAFKA_CLIENT_ID=cyberstream-generator
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_COMPRESSION=snappy

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_HOST_INTERNAL=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cyberstream
POSTGRES_USER=cyberstream
POSTGRES_PASSWORD=changeme_dev_only

# --- Spark (config wired now, pipeline code lands in Phase 5) ---
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=/data/checkpoints
SPARK_SHUFFLE_PARTITIONS_DEV=4
SPARK_SHUFFLE_PARTITIONS_LOADTEST=16
SPARK_WATERMARK_DELAY_MINUTES=5
SPARK_TRIGGER_INTERVAL_SECONDS=10
KAFKA_STARTING_OFFSETS=latest
PRIVILEGED_USERS=admin,root,backup,administrator
DETECTION_ENGINE_ENABLED=true
DETECTION_RULES_CONFIG_PATH=

# --- Storage ---
PARQUET_DATA_DIR=/data/parquet
RAW_EVENTS_DIR=/data/raw
DLQ_DIR=/data/dlq

# --- Retention (days) ---
RETENTION_RAW_EVENTS_DAYS=7
RETENTION_PROCESSED_EVENTS_DAYS=30
RETENTION_ALERTS_DAYS=90
RETENTION_INCIDENTS_DAYS=180

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Generator ---
GENERATOR_DEFAULT_RATE=100
GENERATOR_SEED=42

# --- Frontend (config reserved now, UI code lands in Phase 13) ---
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=5173
